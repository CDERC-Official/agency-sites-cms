{
  "name": "@liskof-digital/agency-sites-platform",
  "version": "1.0.0",
  "description": "Turborepo monorepo for Payload CMS and Nuxt",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:cms": "turbo run dev --filter=@liskof-digital/cms",
    "dev:cms:container": "pnpm --filter @liskof-digital/cms dev:container",
    "dev:web": "turbo run dev --filter=@liskof-digital/web",
    "deploy:cms": "pnpm --filter @liskof-digital/cms deploy:container",
    "deploy:web": "pnpm --filter @liskof-digital/web deploy",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "generate:types": "pnpm --filter @liskof-digital/cms generate:types",
    "generate:importmap": "pnpm --filter @liskof-digital/cms generate:importmap",
    "payload": "pnpm --filter @liskof-digital/cms payload",
    "test": "pnpm --filter @liskof-digital/cms test"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
