{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agency-sites-cms",
  "main": "apps/cms/worker/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "CmsContainer",
      "image": "./apps/cms/Dockerfile",
      "image_build_context": ".",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CMS_CONTAINER",
        "class_name": "CmsContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CmsContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
