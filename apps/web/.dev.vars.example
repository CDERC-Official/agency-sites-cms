# Copy to apps/web/.dev.vars for `pnpm dev:web:cf` / `wrangler dev`.
# Wrangler does not read .env.local. Day-to-day Nuxt dev still uses .env.local.

# Public URL of the Payload CMS API
NUXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# Optional server-only token for authenticated Payload API requests
NUXT_PAYLOAD_API_TOKEN=
