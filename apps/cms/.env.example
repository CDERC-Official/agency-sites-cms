# PostgreSQL connection string. Payload checks these in order:
# STORAGE_POSTGRES_URL, POSTGRES_URL_NON_POOLING, then DATABASE_URL.
DATABASE_URL=postgres://127.0.0.1:5432/agency_sites
# STORAGE_POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Generate a long random value for signing Payload tokens
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public URL used for CORS, links, previews, and sitemap generation
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional scheduled job authentication
CRON_SECRET=
PREVIEW_SECRET=

# Required for production media storage on Vercel
BLOB_MEDIA_READ_WRITE_TOKEN=
