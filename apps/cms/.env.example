# PostgreSQL connection string. Payload checks these in order:
# STORAGE_POSTGRES_URL, POSTGRES_URL_NON_POOLING, then DATABASE_URL.
# Matches the Compose `db` service (`docker compose up -d db`).
# For Wrangler Containers, use the root .dev.vars file instead
# (host.docker.internal so Postgres on the Docker host is reachable).
DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/agency_sites
# STORAGE_POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Generate a long random value for signing Payload tokens
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public URL used for CORS, links, previews, and sitemap generation
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional scheduled job / preview authentication
CRON_SECRET=
PREVIEW_SECRET=

# Cloudflare R2 S3 API credentials (used when NODE_ENV=production)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
